{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]
      ],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/health",
        "expect_status": [200]
      },
      "env": {
        "DB_PATH": {
          "dev": "dev.db"
        },
        "JWT_SECRET": {
          "generate": "hex",
          "bytes": 32
        },
        "JWT_EXPIRY": {
          "dev": "86400"
        }
      }
    },
    {
      "name": "frontend",
      "dir": "frontend",
      "stack": "node",
      "kind": "server",
      "install": [
        ["npm", "ci"]
      ],
      "start": [
        "npm", "run", "dev"
      ],
      "port": 5173,
      "port_env": "PORT",
      "ready_log": "Local:",
      "env": {
        "VITE_API_URL": {
          "dev": "http://localhost:8000"
        }
      }
    }
  ]
}
